@@ -0,0 +1,56 @@
+"""Witness: retrying a request ID after an interruption at the after_effect
+boundary must not add a second item (app/export-contract.md).
+
+Exits 0 if every accepted request added exactly one item after
+interrupt + restart + retry; exits 1 otherwise.
+"""
+import os
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
+
+from app.exports import Exports
+
+
+class Terminated(Exception):
+    pass
+
+
+def crash():
+    raise Terminated("worker terminated after durable effect")
+
+
+def main():
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, "jobs.db")
+
+        # Control: an uninterrupted request, later retried.
+        worker = Exports(path)
+        worker.apply("req-1", "payload-1")
+
+        # Interrupted at the documented boundary, after the durable effect.
+        try:
+            worker.apply("req-2", "payload-2", after_effect=crash)
+        except Terminated:
+            pass
+        worker.close()
+
+        # Restart after the previous worker stopped; retry the same request
+        # IDs with the same payloads, as the contract permits.
+        worker = Exports(path)
+        worker.apply("req-2", "payload-2")
+        worker.apply("req-1", "payload-1")
+        items = worker.items()
+        worker.close()
+
+    expected = ["payload-1", "payload-2"]
+    if sorted(items) != expected:
+        print(f"VIOLATION: expected {expected}, got {items}")
+        return 1
+    print("OK: each accepted request added exactly one item")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
