+"""Witness for app/export-contract.md: accepted jobs eventually produce results.
+
+Scenario A (restart recovery): the worker process dies at the after_claim
+boundary; a fresh process recovers and keeps calling work().
+Scenario B (in-process retry): the after_claim hook raises (a transient I/O
+interruption before output); the same application keeps calling work() once
+the environment recovers, as the contract says it does.
+
+Exits nonzero if any accepted job never gets its result.
+"""
+import os
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+from app.export_queue import Queue  # noqa: E402
+
+RETRIES = 20
+
+CRASH_CHILD = """
+import os, sys
+sys.path.insert(0, sys.argv[1])
+from app.export_queue import Queue
+q = Queue(sys.argv[2])
+q.submit("job-1", "payload-1")
+q.work(after_claim=lambda: os._exit(9))
+"""
+
+
+def drain(q):
+    for _ in range(RETRIES):
+        if not q.work():
+            break
+
+
+def scenario_restart(tmp):
+    path = os.path.join(tmp, "restart.db")
+    proc = subprocess.run([sys.executable, "-I", "-c", CRASH_CHILD, ROOT, path])
+    if proc.returncode != 9:
+        return "child did not reach the after_claim boundary (rc=%d)" % proc.returncode
+    q = Queue(path)
+    try:
+        drain(q)
+        got = q.result("job-1")
+    finally:
+        q.close()
+    if got != "payload-1":
+        return "after restart, result is %r, expected 'payload-1'" % (got,)
+    return None
+
+
+def scenario_in_process_retry(tmp):
+    path = os.path.join(tmp, "retry.db")
+    q = Queue(path)
+    try:
+        q.submit("job-1", "payload-1")
+
+        def transient_failure():
+            raise OSError("transient I/O failure before output")
+
+        try:
+            q.work(after_claim=transient_failure)
+        except OSError:
+            pass  # the application retries after transient I/O failures
+        drain(q)  # environment recovered; work is called repeatedly
+        got = q.result("job-1")
+        state = q.db.execute("SELECT state FROM jobs WHERE id = 'job-1'").fetchone()
+    finally:
+        q.close()
+    if got != "payload-1":
+        return ("after a transient failure and %d work() retries without restart, "
+                "result is %r and job state is %r" % (RETRIES, got, state and state[0]))
+    return None
+
+
+def main():
+    failures = []
+    with tempfile.TemporaryDirectory() as tmp:
+        for name, fn in [("restart recovery", scenario_restart),
+                         ("in-process retry", scenario_in_process_retry)]:
+            err = fn(tmp)
+            print("%s: %s" % (name, "OK" if err is None else "VIOLATION - " + err))
+            if err:
+                failures.append(name)
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
