+"""Witness: a transient I/O failure on the completion transaction strands an
+accepted job even though the same worker keeps calling work() (no restart).
+
+Contract (app/export-contract.md): the application retries work after transient
+I/O failures and calls work repeatedly once the environment recovers; accepted
+jobs must eventually produce their result. Exits nonzero when violated.
+"""
+from pathlib import Path
+import sqlite3
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app.export_queue import Queue
+
+
+class FlakyConnection:
+    """Delegates to the real connection; the first results insert fails."""
+
+    def __init__(self, real):
+        self.real = real
+        self.failures_left = 1
+
+    def execute(self, sql, *args):
+        if self.failures_left and sql.startswith("INSERT INTO results"):
+            self.failures_left -= 1
+            raise sqlite3.OperationalError("disk I/O error")
+        return self.real.execute(sql, *args)
+
+    def __enter__(self):
+        return self.real.__enter__()
+
+    def __exit__(self, *exc):
+        return self.real.__exit__(*exc)
+
+    def close(self):
+        self.real.close()
+
+
+with tempfile.TemporaryDirectory() as scratch:
+    worker = Queue(str(Path(scratch) / "jobs.db"))
+    worker.db = FlakyConnection(worker.db)
+    assert worker.submit("job-1", "hello")["accepted"]
+    try:
+        worker.work()
+    except sqlite3.OperationalError:
+        pass  # transient failure; the environment has now recovered
+    # The application retries: call work repeatedly in the same process.
+    for _ in range(5):
+        worker.work()
+    state = worker.db.execute("SELECT state FROM jobs WHERE id = 'job-1'").fetchone()
+    produced = worker.result("job-1")
+    worker.close()
+
+if produced != "hello":
+    print(f"VIOLATION: job-1 accepted, state={state[0]!r}, result={produced!r} "
+          "after transient failure and 5 in-process retries")
+    sys.exit(1)
+print("OK: job-1 produced its result after in-process retry")
