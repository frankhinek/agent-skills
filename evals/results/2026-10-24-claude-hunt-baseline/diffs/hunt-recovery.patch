+"""Witness: an accepted export job must eventually produce its result after a
+process interruption at the post-claim boundary (app/export-contract.md).
+
+Exits 0 when the promise holds, 1 when it is violated.
+"""
+import os
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
+
+from app.export_queue import Queue  # noqa: E402
+
+
+class Interrupted(Exception):
+    pass
+
+
+def interrupt():
+    raise Interrupted()
+
+
+def main():
+    with tempfile.TemporaryDirectory() as tmp:
+        path = os.path.join(tmp, "jobs.db")
+
+        q = Queue(path)
+        if not q.submit("job-1", "payload-1").get("accepted"):
+            print("FAIL: submit did not accept job-1")
+            return 1
+        try:
+            q.work(after_claim=interrupt)
+        except Interrupted:
+            pass
+        q.close()  # process terminates; only committed state survives
+
+        # Restart after the previous worker stopped; the application keeps
+        # calling work once the environment recovers.
+        q = Queue(path)
+        for _ in range(10):
+            if not q.work():
+                break
+        result = q.result("job-1")
+        state = q.db.execute("SELECT state FROM jobs WHERE id = 'job-1'").fetchone()
+        q.close()
+
+    if result != "payload-1":
+        print(f"FAIL: accepted job-1 has result {result!r} after recovery "
+              f"(job state {state[0] if state else None!r}); expected 'payload-1'")
+        return 1
+    print("OK: accepted job-1 produced its result after interruption and restart")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
