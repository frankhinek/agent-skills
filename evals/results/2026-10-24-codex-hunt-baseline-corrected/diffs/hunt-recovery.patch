+"""Acceptance/restart checks: exit nonzero if the contract is violated."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from app.export_queue import Queue
+
+
+def check(path, boundary):
+    if boundary == 'running':
+        child = """
+import os, sys
+from app.export_queue import Queue
+q = Queue(sys.argv[1])
+assert q.submit('job', 'payload')['accepted']
+q.work(after_claim=lambda: os._exit(73))
+"""
+        run = subprocess.run([sys.executable, '-B', '-c', child, str(path)], cwd=ROOT)
+        assert run.returncode == 73, f'hook not reached: {run.returncode}'
+    else:
+        q = Queue(path)
+        assert q.submit('job', 'payload')['accepted']
+        if boundary == 'done':
+            assert q.work()
+        q.close()
+    q = Queue(path)
+    try:
+        for _ in range(5):
+            q.work()
+        assert q.result('job') == 'payload', (
+            'accepted job has no result after restart; durable jobs='
+            + repr(q.db.execute('SELECT * FROM jobs').fetchall())
+        )
+        assert q.work() is False, 'completed job scheduled again'
+        assert q.submit('job', 'payload')['accepted']
+        assert q.work() is False
+        assert q.result('job') == 'payload'
+    finally:
+        q.close()
+
+
+def main():
+    failures = 0
+    for boundary in ('pending', 'running', 'done'):
+        with tempfile.TemporaryDirectory() as directory:
+            try:
+                check(Path(directory) / 'jobs.sqlite', boundary)
+            except AssertionError as exc:
+                failures += 1
+                print(f'FAIL {boundary}: {exc}')
+            else:
+                print(f'PASS {boundary}')
+    return int(failures != 0)
+
+
+if __name__ == '__main__':
+    sys.exit(main())
