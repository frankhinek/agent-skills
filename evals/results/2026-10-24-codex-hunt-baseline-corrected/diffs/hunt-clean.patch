+"""Bounded contract checks; run with python3 tests/hunt_witness.py."""
+import os
+from pathlib import Path
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from app.export_queue import Queue
+
+
+class DurableExport(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.path = str(Path(self.tmp.name) / "jobs.sqlite")
+
+    def child(self, body):
+        script = (
+            "import os, sys\nfrom app.export_queue import Queue\n"
+            "q = Queue(sys.argv[1])\n" + body
+        )
+        result = subprocess.run(
+            [sys.executable, "-c", script, self.path], cwd=ROOT,
+            capture_output=True, text=True, timeout=10,
+        )
+        self.assertEqual(result.returncode, 73, result.stderr)
+
+    def drain(self):
+        q = Queue(self.path)
+        try:
+            for _ in range(5):
+                if not q.work():
+                    break
+            self.assertEqual(q.result("a"), "payload")
+            self.assertFalse(q.work())
+            self.assertEqual(q.db.execute(
+                "SELECT state FROM jobs WHERE id='a'"
+            ).fetchone(), ("done",))
+            self.assertEqual(q.db.execute(
+                "SELECT count(*) FROM results WHERE id='a'"
+            ).fetchone(), (1,))
+        finally:
+            q.close()
+
+    def test_accepted_survives_process_exit(self):
+        self.child("assert q.submit('a', 'payload')['accepted']\nos._exit(73)\n")
+        self.drain()
+
+    def test_interrupted_claim_restarts(self):
+        self.child("q.submit('a', 'payload')\nq.work(after_claim=lambda: os._exit(73))\n")
+        with sqlite3.connect(self.path) as db:
+            self.assertEqual(db.execute("SELECT state FROM jobs").fetchone(), ("running",))
+        self.drain()
+
+    def test_output_transaction_interruption(self):
+        # Real process exits after INSERT or after UPDATE, before their commit.
+        for boundary in ("UPDATE jobs SET state = 'done'", "COMMIT"):
+            with self.subTest(boundary=boundary):
+                for suffix in ("", "-journal", "-wal", "-shm"):
+                    Path(self.path + suffix).unlink(missing_ok=True)
+                self.child(
+                    "q.submit('a', 'payload')\n"
+                    "def arm():\n"
+                    "    def trace(sql):\n"
+                    f"        if sql.startswith({boundary!r}): os._exit(73)\n"
+                    "    q.db.set_trace_callback(trace)\n"
+                    "q.work(after_claim=arm)\n"
+                )
+                self.drain()
+
+    def test_completed_survives_restart(self):
+        self.child("q.submit('a', 'payload')\nassert q.work()\nos._exit(73)\n")
+        self.drain()
+
+    def test_transient_write_failure_then_retry(self):
+        q = Queue(self.path)
+        try:
+            q.submit("a", "payload")
+            q.db.execute("CREATE TEMP TRIGGER fail_output BEFORE INSERT ON results "
+                         "BEGIN SELECT RAISE(ABORT, 'transient failure'); END")
+            with self.assertRaises(sqlite3.DatabaseError):
+                q.work()
+            q.db.execute("DROP TRIGGER fail_output")
+            self.assertTrue(q.work())
+            self.assertEqual(q.result("a"), "payload")
+        finally:
+            q.close()
+        self.drain()
+
+    def test_same_payload_resubmission(self):
+        q = Queue(self.path)
+        try:
+            q.submit("a", "payload")
+            q.submit("a", "payload")
+            self.assertTrue(q.work())
+            q.submit("a", "payload")
+            self.assertFalse(q.work())
+        finally:
+            q.close()
+        self.drain()
+
+
+if __name__ == "__main__":
+    unittest.main()
