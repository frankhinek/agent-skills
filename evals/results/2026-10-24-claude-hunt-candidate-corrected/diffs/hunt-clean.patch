@@ -0,0 +1,162 @@
+"""Witness: export worker acceptance and restart recovery (app/export-contract.md).
+
+Exits 0 when every accepted job produces its result after interruption and
+recovery, and nonzero when any scenario violates that obligation.
+
+Run from the project root:  python3 tests/hunt_witness.py
+Set HUNT_APP_ROOT to point at another copy of the project (mutation checks).
+"""
+import os
+import sqlite3
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.environ.get(
+    "HUNT_APP_ROOT", os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
+)
+sys.path.insert(0, ROOT)
+from app.export_queue import Queue  # noqa: E402
+
+# Child process: open the queue, run one script step, and terminate abruptly
+# (os._exit skips cleanup, like a killed worker) at the hook boundary.
+CHILD = r"""
+import os, sys
+sys.path.insert(0, sys.argv[1])
+from app.export_queue import Queue
+q = Queue(sys.argv[2])
+mode = sys.argv[3]
+if mode == "submit_then_die":
+    r = q.submit(sys.argv[4], sys.argv[5])
+    assert r == {"accepted": True, "id": sys.argv[4]}, r
+    os._exit(0)
+elif mode == "die_after_claim":
+    q.work(after_claim=lambda: os._exit(9))
+    os._exit(1)  # hook was never reached
+"""
+
+FAILURES = []
+
+
+def check(name, cond, detail=""):
+    print(("ok   " if cond else "FAIL ") + name + ((": " + detail) if detail else ""))
+    if not cond:
+        FAILURES.append(name)
+
+
+def child(db, *args):
+    return subprocess.run([sys.executable, "-c", CHILD, ROOT, db, *args]).returncode
+
+
+def drain(q, limit=50):
+    """The application calls work repeatedly once the environment recovers."""
+    for _ in range(limit):
+        if not q.work():
+            return True
+    return False
+
+
+def states(db):
+    # Raw read: opening a Queue would run recover() and hide the crash state.
+    conn = sqlite3.connect(db)
+    rows = dict(conn.execute("SELECT id, state FROM jobs").fetchall())
+    conn.close()
+    return rows
+
+
+class Interrupt(Exception):
+    pass
+
+
+def raise_interrupt():
+    raise Interrupt()
+
+
+def scenario_kill_after_claim(tmp):
+    db = os.path.join(tmp, "kill.db")
+    q = Queue(db)
+    q.submit("job-a", "payload-a")
+    q.close()
+    rc = child(db, "die_after_claim")
+    check("kill: worker died at post-claim hook", rc == 9, "rc=%d" % rc)
+    check("kill: job left running", states(db).get("job-a") == "running", str(states(db)))
+    q = Queue(db)  # restart
+    check("kill: drains after restart", drain(q))
+    check("kill: result produced", q.result("job-a") == "payload-a", repr(q.result("job-a")))
+    q.close()
+    check("kill: job done", states(db).get("job-a") == "done", str(states(db)))
+
+
+def scenario_repeated_kills(tmp):
+    db = os.path.join(tmp, "repeat.db")
+    q = Queue(db)
+    for i in range(3):
+        q.submit("job-%d" % i, "p%d" % i)
+    q.close()
+    for _ in range(3):
+        child(db, "die_after_claim")
+    q = Queue(db)
+    check("repeat: drains after restarts", drain(q))
+    got = {j: q.result(j) for j in ("job-0", "job-1", "job-2")}
+    check("repeat: all results", got == {"job-0": "p0", "job-1": "p1", "job-2": "p2"}, str(got))
+    q.close()
+
+
+def scenario_acceptance_survives_kill(tmp):
+    db = os.path.join(tmp, "accept.db")
+    rc = child(db, "submit_then_die", "job-x", "payload-x")
+    check("accept: submit child exited", rc == 0, "rc=%d" % rc)
+    q = Queue(db)
+    check("accept: drains after restart", drain(q))
+    check("accept: result produced", q.result("job-x") == "payload-x", repr(q.result("job-x")))
+    q.close()
+
+
+def scenario_transient_retry_no_restart(tmp):
+    db = os.path.join(tmp, "transient.db")
+    q = Queue(db)
+    q.submit("job-t", "payload-t")
+    q.submit("job-u", "payload-u")
+    try:
+        q.work(after_claim=raise_interrupt)
+        check("transient: hook raised", False)
+    except Interrupt:
+        pass
+    # Same process retries work after the transient failure.
+    check("transient: drains on retry", drain(q))
+    check("transient: interrupted job result", q.result("job-t") == "payload-t", repr(q.result("job-t")))
+    check("transient: other job result", q.result("job-u") == "payload-u", repr(q.result("job-u")))
+    q.close()
+
+
+def scenario_completed_needs_no_work(tmp):
+    db = os.path.join(tmp, "done.db")
+    q = Queue(db)
+    q.submit("job-d", "payload-d")
+    check("done: drains", drain(q))
+    r = q.submit("job-d", "payload-d")  # same ID, same payload (contract)
+    check("done: resubmit accepted", r == {"accepted": True, "id": "job-d"}, str(r))
+    check("done: no further work", q.work() is False)
+    q.close()
+    q = Queue(db)  # restart must not resurrect completed jobs
+    check("done: no work after restart", q.work() is False)
+    check("done: result kept", q.result("job-d") == "payload-d", repr(q.result("job-d")))
+    q.close()
+
+
+def main():
+    with tempfile.TemporaryDirectory() as tmp:
+        scenario_kill_after_claim(tmp)
+        scenario_repeated_kills(tmp)
+        scenario_acceptance_survives_kill(tmp)
+        scenario_transient_retry_no_restart(tmp)
+        scenario_completed_needs_no_work(tmp)
+    if FAILURES:
+        print("VIOLATED: %d check(s) failed" % len(FAILURES))
+        return 1
+    print("HOLDS: all checks passed")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
