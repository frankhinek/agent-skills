@@ -0,0 +1,65 @@
+"""Witness: an accepted export job must produce its result after restart.
+
+Contract (app/export-contract.md): accepted jobs must eventually produce their
+result after recovery; restart happens after the previous worker stopped; the
+application calls work() repeatedly once the environment recovers.
+
+Schedule: submit job "j1", run work() in a child process that terminates
+(os._exit) at the after_claim hook, i.e. after the 'running' state commits and
+before output. Then construct a fresh Queue on the same database (restart) and
+call work() repeatedly. Exit 0 if result("j1") becomes "payload-1", else 1.
+
+Run: python3 tests/hunt_witness.py
+"""
+import os
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+from app.export_queue import Queue  # noqa: E402
+
+CHILD = r"""
+import os, sys
+sys.path.insert(0, sys.argv[1])
+from app.export_queue import Queue
+q = Queue(sys.argv[2])
+q.submit("j1", "payload-1")
+q.work(after_claim=lambda: os._exit(17))
+"""
+
+RETRIES = 50
+
+
+def main():
+    with tempfile.TemporaryDirectory() as tmp:
+        db = os.path.join(tmp, "jobs.sqlite")
+        child = subprocess.run([sys.executable, "-c", CHILD, ROOT, db])
+        if child.returncode != 17:
+            print(f"setup failed: child exited {child.returncode}, expected 17")
+            return 2
+
+        q = Queue(db)  # restart: the previous worker has stopped
+        try:
+            state = q.db.execute("SELECT state FROM jobs WHERE id='j1'").fetchone()
+            for _ in range(RETRIES):
+                q.work()
+            got = q.result("j1")
+            final = q.db.execute("SELECT state FROM jobs WHERE id='j1'").fetchone()
+        finally:
+            q.close()
+
+    if got == "payload-1":
+        print("OK: accepted job j1 produced its result after restart")
+        return 0
+    print("VIOLATION: accepted job j1 never produced a result after restart")
+    print(f"  state after interruption: {state[0] if state else None}")
+    print(f"  state after {RETRIES} work() calls: {final[0] if final else None}")
+    print(f"  result('j1') = {got!r}")
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
