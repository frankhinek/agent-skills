+"""Witness: an accepted export job must produce its result after restart.
+
+Per app/export-contract.md, a committed transaction survives process
+termination, restart happens after the previous worker stopped, and accepted
+jobs must eventually produce their result after recovery. The after_claim hook
+is the supported interruption point after the running state commits.
+
+Exits 0 if the promise holds, 1 if it is violated, 2 on setup failure.
+"""
+import os
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+from app.export_queue import Queue  # noqa: E402
+
+CHILD = r"""
+import os, sys
+sys.path.insert(0, sys.argv[1])
+from app.export_queue import Queue
+q = Queue(sys.argv[2])
+assert q.submit("job-1", "payload-1")["accepted"]
+q.work(after_claim=lambda: os._exit(17))  # process dies before output
+"""
+
+
+def main():
+    with tempfile.TemporaryDirectory() as tmp:
+        db = os.path.join(tmp, "jobs.db")
+        child = subprocess.run([sys.executable, "-I", "-c", CHILD, ROOT, db])
+        if child.returncode != 17:
+            print(f"setup failed: child exited {child.returncode}, expected 17")
+            return 2
+
+        # Restart after the previous worker stopped: a fresh worker on the
+        # same database; the environment has recovered, so the application
+        # calls work repeatedly.
+        q = Queue(db)
+        try:
+            for _ in range(10):
+                if q.result("job-1") is not None:
+                    break
+                q.work()
+            got = q.result("job-1")
+            state = q.db.execute(
+                "SELECT state FROM jobs WHERE id = 'job-1'").fetchone()
+        finally:
+            q.close()
+
+    if got != "payload-1":
+        print(f"VIOLATED: accepted job-1 has result {got!r} after restart "
+              f"and repeated work(); job state is {state[0] if state else None!r}")
+        return 1
+    print("HOLDS: accepted job-1 produced its result after restart")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
