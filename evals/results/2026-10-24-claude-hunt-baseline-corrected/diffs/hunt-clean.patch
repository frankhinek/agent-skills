@@ -0,0 +1,101 @@
+"""Witness: accepted export jobs produce their result after an interruption.
+
+Contract (app/export-contract.md): a committed transaction survives process
+termination; restart follows the previous worker's stop; work is called
+repeatedly after recovery; accepted jobs must eventually produce their result.
+Exits nonzero if any scenario violates that obligation.
+"""
+import os
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+from app.export_queue import Queue  # noqa: E402
+
+CHILD = r"""
+import os, sys
+sys.path.insert(0, sys.argv[1])
+from app.export_queue import Queue
+path, mode = sys.argv[2], sys.argv[3]
+q = Queue(path)
+assert q.submit("job-1", "payload-1") == {"accepted": True, "id": "job-1"}
+if mode == "after_submit":
+    os._exit(9)
+if mode == "after_claim":
+    q.work(after_claim=lambda: os._exit(9))
+if mode == "after_done":
+    q.submit("job-2", "payload-2")
+    q.work()
+    os._exit(9)
+"""
+
+
+def drain(q, limit=10):
+    for _ in range(limit):
+        if not q.work():
+            return
+
+
+def check(name, ok, failures):
+    print(("ok   " if ok else "FAIL ") + name)
+    if not ok:
+        failures.append(name)
+
+
+def boom():
+    raise OSError("interrupted before output")
+
+
+def main():
+    failures = []
+    with tempfile.TemporaryDirectory() as tmp:
+        # Hard process termination at each durable boundary, then restart.
+        for mode in ("after_submit", "after_claim", "after_done"):
+            path = os.path.join(tmp, mode + ".db")
+            rc = subprocess.run([sys.executable, "-I", "-c", CHILD, ROOT, path, mode]).returncode
+            check(f"{mode}: child terminated abruptly", rc == 9, failures)
+            q = Queue(path)
+            drain(q)
+            check(f"{mode}: job-1 result after restart", q.result("job-1") == "payload-1", failures)
+            if mode == "after_done":
+                check(f"{mode}: job-2 result after restart", q.result("job-2") == "payload-2", failures)
+                check(f"{mode}: completed jobs need no further work", q.work() is False, failures)
+            q.close()
+
+        # Interruption raised at the hook, retried in the same process.
+        path = os.path.join(tmp, "inproc.db")
+        q = Queue(path)
+        q.submit("job-1", "payload-1")
+        try:
+            q.work(after_claim=boom)
+        except OSError:
+            pass
+        drain(q)
+        check("in-process retry: result produced", q.result("job-1") == "payload-1", failures)
+        q.close()
+
+        # Repeated interruptions across several restarts.
+        path = os.path.join(tmp, "repeat.db")
+        q = Queue(path)
+        q.submit("job-1", "payload-1")
+        q.close()
+        for _ in range(3):
+            q = Queue(path)
+            try:
+                q.work(after_claim=boom)
+            except OSError:
+                pass
+            q.close()
+        q = Queue(path)
+        drain(q)
+        check("repeated interruptions: result produced", q.result("job-1") == "payload-1", failures)
+        q.close()
+
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
