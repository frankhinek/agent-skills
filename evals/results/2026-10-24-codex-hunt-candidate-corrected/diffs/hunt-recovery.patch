+"""Run with python3 -B tests/hunt_witness.py; no third-party dependencies."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app.export_queue import Queue
+
+
+def interrupt():
+    os._exit(73)
+
+
+def child(path, boundary):
+    queue = Queue(path)
+    assert queue.submit("job", "payload") == {"accepted": True, "id": "job"}
+    if boundary == "pending":
+        interrupt()
+    queue.work(after_claim=interrupt)
+    raise AssertionError("interruption hook was not reached")
+
+
+def check(path, boundary):
+    result = subprocess.run(
+        [sys.executable, "-B", __file__, "--child", path, boundary],
+        check=False,
+    )
+    assert result.returncode == 73, result.returncode
+    queue = Queue(path)
+    try:
+        initial = queue.db.execute("SELECT state FROM jobs").fetchone()[0]
+        # A finite check plus the report's closed-state argument establishes
+        # why further calls cannot help the broken implementation.
+        for _ in range(5):
+            queue.work()
+        assert queue.result("job") == "payload", (
+            f"{boundary}: accepted job has no result after restart and five "
+            f"work calls (initial persisted state={initial})"
+        )
+        assert not queue.work(), "completed job was selected again"
+    finally:
+        queue.close()
+    queue = Queue(path)
+    try:
+        queue.submit("job", "payload")  # supported retry, same payload
+        assert not queue.work(), "completed retry created more work"
+        assert queue.result("job") == "payload"
+    finally:
+        queue.close()
+
+
+def main():
+    failures = []
+    with tempfile.TemporaryDirectory(prefix="export-hunt-") as scratch:
+        for boundary in ("pending", "running"):
+            try:
+                check(str(Path(scratch) / (boundary + ".sqlite")), boundary)
+            except AssertionError as error:
+                failures.append(str(error))
+                print("FAIL:", error)
+            else:
+                print("PASS:", boundary, "restart, completion and completed retry")
+    return int(bool(failures))
+
+
+if __name__ == "__main__":
+    if len(sys.argv) > 1 and sys.argv[1] == "--child":
+        child(sys.argv[2], sys.argv[3])
+    else:
+        sys.exit(main())
