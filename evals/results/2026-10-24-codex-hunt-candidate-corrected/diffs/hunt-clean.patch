+"""Bounded export durability checks; run: python3 tests/hunt_witness.py."""
+import os
+from pathlib import Path
+import sqlite3
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from app.export_queue import Queue
+
+
+def require(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def child(path, boundary):
+    queue = Queue(path)
+    require(queue.submit("a", "original")["accepted"], "job rejected")
+    if boundary == "accepted":
+        os._exit(23)
+    if boundary == "running":
+        queue.work(after_claim=lambda: os._exit(23))
+    if boundary == "done":
+        queue.work()
+        os._exit(23)
+    raise AssertionError("unknown boundary")
+
+
+def check_restart(directory, boundary):
+    path = str(Path(directory) / (boundary + ".sqlite"))
+    run = subprocess.run([sys.executable, str(Path(__file__).resolve()),
+                          "--child", path, boundary])
+    require(run.returncode == 23, "child did not reach interruption boundary")
+    with sqlite3.connect(path) as db:
+        state = db.execute("SELECT state FROM jobs WHERE id = 'a'").fetchone()
+        expected = {"accepted": "pending", "running": "running", "done": "done"}
+        require(state == (expected[boundary],), "unexpected durable state")
+    queue = Queue(path)
+    try:
+        require(queue.submit("a", "original")["accepted"], "retry rejected")
+        require(queue.work() == (boundary != "done"), "recovery work mismatch")
+        require(queue.result("a") == "original", "accepted result missing or changed")
+        require(queue.work() is False, "completed job scheduled again")
+        require(queue.db.execute("SELECT count(*) FROM results").fetchone() == (1,),
+                "unexpected result count")
+    finally:
+        queue.close()
+
+
+def check_retry(directory):
+    queue = Queue(str(Path(directory) / "retry.sqlite"))
+    try:
+        queue.submit("a", "first")
+        queue.submit("b", "second")
+
+        def interrupt():
+            raise OSError("injected interruption after running commit")
+
+        try:
+            queue.work(after_claim=interrupt)
+        except OSError:
+            pass
+        else:
+            raise AssertionError("interruption not exercised")
+        require(queue.result("a") is None, "output exists before output transaction")
+        # Fail completion after result insertion, testing rollback of both effects.
+        queue.db.executescript("""
+            CREATE TEMP TRIGGER fail_completion BEFORE UPDATE OF state ON jobs
+            WHEN NEW.state = 'done'
+            BEGIN SELECT RAISE(ABORT, 'injected completion failure'); END;
+        """)
+        try:
+            queue.work()
+        except sqlite3.IntegrityError as error:
+            require("injected completion failure" in str(error), "unexpected I/O surrogate")
+        else:
+            raise AssertionError("transaction failure not exercised")
+        require(queue.result("a") is None, "failed transaction left partial output")
+        queue.db.execute("DROP TRIGGER fail_completion")
+        require(queue.work() is True, "running job not retried")
+        require(queue.work() is True, "later accepted job abandoned")
+        require(queue.result("a") == "first", "first result missing")
+        require(queue.result("b") == "second", "later result missing")
+        require(queue.work() is False, "completed work repeated")
+    finally:
+        queue.close()
+
+
+def main():
+    with tempfile.TemporaryDirectory(prefix="export-hunt-") as directory:
+        for boundary in ("accepted", "running", "done"):
+            check_restart(directory, boundary)
+            print("PASS process interruption:", boundary)
+        check_retry(directory)
+        print("PASS retry, transaction rollback, and subsequent accepted work")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) > 1 and sys.argv[1] == "--child":
+        child(sys.argv[2], sys.argv[3])
+    else:
+        main()
