@@ -1,5 +1,9 @@
 (set-logic QF_LIA)
 (define-fun identity ((x Int)) Int (+ x 0))
 (declare-const x Int)
+; identity_add_zero: for every mathematical integer x, identity(x) = x.
+; This assertion asks for a counterexample; unsat discharges the guarantee
+; for all integers under the SMT source and solver semantics trusted here.
+; See verification/README.md for the pinned solver and reproduction command.
 (assert (! (not (= (identity x) x)) :named identity_add_zero))
 (check-sat)
