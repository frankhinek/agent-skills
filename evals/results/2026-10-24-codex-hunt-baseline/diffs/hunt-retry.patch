+"""Check export duplicate effects using only sequential, local SQLite calls."""
+
+import sqlite3
+import sys
+import tempfile
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app.exports import Exports
+
+
+def check(restart, interruptions):
+    with tempfile.TemporaryDirectory() as directory:
+        path = str(Path(directory) / "jobs.sqlite")
+        worker = Exports(path)
+
+        def interrupt():
+            raise OSError("simulated transient failure after durable effect")
+
+        try:
+            for _ in range(interruptions):
+                try:
+                    worker.apply("request-1", "payload", after_effect=interrupt)
+                except OSError:
+                    pass
+                if restart:
+                    worker.close()
+                    worker = Exports(path)
+            assert worker.apply("request-1", "payload") is True
+            assert worker.apply("request-1", "payload") is True
+            actual = worker.items()
+            # Inspect durable state independently of the application's accessor.
+            with sqlite3.connect(path) as observer:
+                durable = [row[0] for row in observer.execute("SELECT payload FROM items")]
+            if actual != ["payload"] or durable != ["payload"]:
+                return f"restart={restart}, interruptions={interruptions}: expected one item; observed {durable!r}"
+        finally:
+            worker.close()
+    return None
+
+
+def main():
+    failures = []
+    for restart in (False, True):
+        for interruptions in (0, 1, 2):
+            failure = check(restart, interruptions)
+            if failure:
+                failures.append(failure)
+                print("FAIL:", failure)
+            else:
+                print(f"PASS: restart={restart}, interruptions={interruptions}")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
