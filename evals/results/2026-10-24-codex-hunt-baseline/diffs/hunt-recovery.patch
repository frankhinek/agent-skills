+"""Run with python3 tests/hunt_witness.py; nonzero means contract violation."""
+
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app.export_queue import Queue
+
+
+def accept(queue):
+    assert queue.submit("job-1", "payload") == {
+        "accepted": True, "id": "job-1"
+    }
+
+
+class ExportRecoveryWitness(unittest.TestCase):
+    def test_accepted_pending_job_survives_restart(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = str(Path(directory) / "jobs.sqlite")
+            queue = Queue(path)
+            accept(queue)
+            queue.close()
+            queue = Queue(path)
+            try:
+                self.assertTrue(queue.work())
+                self.assertEqual(queue.result("job-1"), "payload")
+            finally:
+                queue.close()
+
+    def test_completed_job_needs_no_work_after_restart(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = str(Path(directory) / "jobs.sqlite")
+            queue = Queue(path)
+            accept(queue)
+            self.assertTrue(queue.work())
+            queue.close()
+            queue = Queue(path)
+            try:
+                accept(queue)  # Retry the same ID and its unchanged payload.
+                self.assertFalse(queue.work())
+                self.assertEqual(queue.result("job-1"), "payload")
+            finally:
+                queue.close()
+
+    def test_accepted_claimed_job_survives_process_interruption(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = str(Path(directory) / "jobs.sqlite")
+            child = subprocess.run(
+                [sys.executable, str(Path(__file__).resolve()), "--interrupt", path],
+                capture_output=True, text=True, timeout=10,
+            )
+            self.assertEqual(child.returncode, 73, child.stdout + child.stderr)
+            # The prior worker is stopped before this worker starts.
+            queue = Queue(path)
+            try:
+                for _ in range(5):
+                    queue.work()
+                # Retrying acceptance must not erase the outstanding obligation.
+                accept(queue)
+                for _ in range(5):
+                    queue.work()
+                state = queue.db.execute(
+                    "SELECT state FROM jobs WHERE id = ?", ("job-1",)
+                ).fetchone()
+                self.assertEqual(
+                    queue.result("job-1"), "payload",
+                    f"Accepted job lost after restart and repeated work: {state=}",
+                )
+            finally:
+                queue.close()
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 3 and sys.argv[1] == "--interrupt":
+        queue = Queue(sys.argv[2])
+        accept(queue)
+        queue.work(after_claim=lambda: os._exit(73))
+        raise AssertionError("Interruption boundary was not reached")
+    unittest.main(verbosity=2)
