+"""Contract witnesses: nonzero if any promised behavior is violated."""
+from pathlib import Path
+import sqlite3
+import sys
+import tempfile
+
+sys.dont_write_bytecode = True
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app.export_queue import Queue
+
+
+def conflicting_payload(path, completed):
+    worker = Queue(path)
+    try:
+        assert worker.submit("job", "original")["accepted"]
+        if completed:
+            worker.work()
+        reply = worker.submit("job", "replacement")
+        assert not reply["accepted"], (
+            "conflicting payload accepted for an existing job ID"
+        )
+    finally:
+        worker.close()
+
+
+def transient_output_failure(path):
+    worker = Queue(path)
+    try:
+        assert worker.submit("job", "hello")["accepted"]
+        # Deny exactly one output INSERT using SQLite's connection-local
+        # authorizer. Production work executes both real transactions.
+        def deny_output(action, table, *_):
+            if action == sqlite3.SQLITE_INSERT and table == "results":
+                return sqlite3.SQLITE_DENY
+            return sqlite3.SQLITE_OK
+
+        worker.db.set_authorizer(deny_output)
+        failed = False
+        try:
+            worker.work()
+        except sqlite3.DatabaseError:
+            failed = True
+        finally:
+            worker.db.set_authorizer(lambda *_: sqlite3.SQLITE_OK)
+        assert failed, "fault injection did not reach output INSERT"
+        for _ in range(3):
+            worker.work()
+        assert worker.result("job") == "hello", (
+            "accepted job stranded after output failure and same-worker retries"
+        )
+    finally:
+        worker.close()
+
+
+def main():
+    failures = []
+    with tempfile.TemporaryDirectory() as scratch:
+        cases = [
+            ("conflict-pending", lambda p: conflicting_payload(p, False)),
+            ("conflict-done", lambda p: conflicting_payload(p, True)),
+            ("output-retry", transient_output_failure),
+        ]
+        for name, check in cases:
+            try:
+                check(str(Path(scratch) / (name + ".db")))
+            except Exception as error:
+                failures.append(name)
+                print(f"FAIL {name}: {type(error).__name__}: {error}")
+            else:
+                print(f"PASS {name}")
+    return bool(failures)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
