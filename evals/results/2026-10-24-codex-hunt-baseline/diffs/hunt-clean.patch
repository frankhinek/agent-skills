@@ -0,0 +1,73 @@
+"""Run with python3 tests/hunt_witness.py; nonzero means contract violation."""
+
+import pathlib
+import sqlite3
+import subprocess
+import sys
+import tempfile
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from app.export_queue import Queue
+
+
+def interrupted_job(path):
+    queue = Queue(path)
+    assert queue.submit("job", "payload") == {"accepted": True, "id": "job"}
+    queue.close()
+    child = subprocess.run(
+        [sys.executable, "-c", """
+import os, sys
+from app.export_queue import Queue
+queue = Queue(sys.argv[1])
+queue.work(after_claim=lambda: os._exit(73))
+""", str(path)],
+        cwd=ROOT,
+        check=False,
+    )
+    assert child.returncode == 73, child.returncode
+    with sqlite3.connect(path) as db:
+        assert db.execute("SELECT state FROM jobs").fetchall() == [("running",)]
+        assert db.execute("SELECT * FROM results").fetchall() == []
+    return Queue(path)
+
+
+def main():
+    with tempfile.TemporaryDirectory(prefix="export-hunt-") as directory:
+        directory = pathlib.Path(directory)
+        queue = interrupted_job(directory / "control.sqlite")
+        assert queue.work() is True
+        assert queue.result("job") == "payload"
+        assert queue.work() is False
+        queue.close()
+        print("PASS: interrupted accepted job completes after restart", flush=True)
+
+        path = directory / "retry.sqlite"
+        queue = interrupted_job(path)
+        queue.db.execute("PRAGMA busy_timeout = 1")
+        blocker = sqlite3.connect(path)
+        try:
+            # Take a real SQLite writer lock only after the running commit.
+            # The hook returns normally; failure comes from production SQL.
+            try:
+                queue.work(after_claim=lambda: blocker.execute("BEGIN IMMEDIATE"))
+            except sqlite3.OperationalError as error:
+                assert "locked" in str(error), str(error)
+            else:
+                raise AssertionError("negative control did not induce a lock failure")
+            blocker.rollback()
+            attempts = [queue.work() for _ in range(5)]
+            state = queue.db.execute("SELECT state FROM jobs").fetchone()[0]
+            result = queue.result("job")
+            print(f"After lock release: attempts={attempts}, state={state}, result={result!r}")
+            assert result == "payload", (
+                "accepted job stranded after restart and transient I/O failure: "
+                "work selects only pending jobs, but this job remains running"
+            )
+        finally:
+            blocker.close()
+            queue.close()
+
+
+if __name__ == "__main__":
+    main()
