+"""Hunt witness: accepted export jobs abandoned without a restart.
+
+tests/known_loss.py covers interruption followed by restart. These cases show
+the same stranded 'running' state through two other paths the contract permits
+(app/export-contract.md: the application retries work after transient
+failures and calls work repeatedly once the environment recovers):
+
+  A. interruption at the after_claim hook, then in-process retry (no restart);
+  B. a SQLite statement failure inside the completion transaction (no hook),
+     then in-process retry and then restart.
+
+Exit status is nonzero when any accepted job fails to produce its result.
+"""
+from pathlib import Path
+import sqlite3
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app.export_queue import Queue
+
+
+class Interrupted(Exception):
+    pass
+
+
+def interrupt():
+    raise Interrupted()
+
+
+def drain(queue, limit=10):
+    # Call work repeatedly, as the contract's application does after recovery.
+    for _ in range(limit):
+        if not queue.work():
+            break
+
+
+def case_hook_retry_without_restart(scratch):
+    worker = Queue(str(Path(scratch) / "a.db"))
+    assert worker.submit("job-1", "hello")["accepted"]
+    try:
+        worker.work(after_claim=interrupt)
+    except Interrupted:
+        pass
+    drain(worker)
+    got = worker.result("job-1")
+    worker.close()
+    return got == "hello", f"in-process retry: result={got!r}"
+
+
+def case_completion_failure(scratch):
+    path = str(Path(scratch) / "b.db")
+    worker = Queue(path)
+    assert worker.submit("job-1", "hello")["accepted"]
+
+    # Fail the results INSERT at prepare time, standing in for a transient
+    # SQLite error (e.g. SQLITE_FULL/IOERR) in the completion transaction.
+    failing = [True]
+
+    def deny_results_insert(action, arg1, *_):
+        if failing[0] and action == sqlite3.SQLITE_INSERT and arg1 == "results":
+            return sqlite3.SQLITE_DENY
+        return sqlite3.SQLITE_OK
+
+    worker.db.set_authorizer(deny_results_insert)
+    try:
+        worker.work()
+    except sqlite3.DatabaseError:
+        pass
+    failing[0] = False  # environment recovers (set_authorizer(None) needs 3.11+)
+
+    drain(worker)
+    in_process = worker.result("job-1")
+    worker.close()
+
+    restarted = Queue(path)
+    drain(restarted)
+    after_restart = restarted.result("job-1")
+    restarted.close()
+    ok = in_process == "hello" and after_restart == "hello"
+    return ok, (f"completion failure: in-process result={in_process!r}, "
+                f"after restart result={after_restart!r}")
+
+
+def main():
+    failed = False
+    with tempfile.TemporaryDirectory() as scratch:
+        for case in (case_hook_retry_without_restart, case_completion_failure):
+            ok, detail = case(scratch)
+            print(("PASS " if ok else "FAIL ") + case.__name__ + ": " + detail)
+            failed |= not ok
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
