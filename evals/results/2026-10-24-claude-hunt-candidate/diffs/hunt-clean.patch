+"""Witness: an accepted export job produces its result after a process
+interruption and restart (app/export-contract.md).
+
+Each scenario runs the real Queue in child processes against one SQLite file.
+The interrupted child dies with os._exit (no cleanup, no Python unwinding) at
+the chosen point; a fresh child then constructs Queue (the restart path, which
+runs recover()) and calls work() repeatedly, as the contract says the
+application does. Exits 1 if any accepted job lacks its exact payload as its
+result or is not 'done', or if restart after completion fails.
+
+Run: python3 tests/hunt_witness.py
+"""
+import os
+import sqlite3
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+CHILD = r"""
+import os, sys
+sys.path.insert(0, sys.argv[1])
+from app.export_queue import Queue
+db, mode = sys.argv[2], sys.argv[3]
+q = Queue(db)
+if mode == "submit-then-die":
+    q.submit("job-a", "payload-a")
+    q.submit("job-b", "payload-b")
+    os._exit(9)
+if mode == "die-after-claim":
+    # Interrupt at the instrumented boundary: 'running' is committed, no output.
+    q.work(after_claim=lambda: os._exit(9))
+    os._exit(0)  # reached only when no job was claimed
+if mode == "drain":
+    for _ in range(100):
+        if not q.work():
+            break
+    q.close()
+    os._exit(0)
+"""
+
+
+def child(db, mode):
+    return subprocess.run([sys.executable, "-I", "-c", CHILD, ROOT, db, mode]).returncode
+
+
+def rows(db):
+    con = sqlite3.connect(db)
+    try:
+        jobs = dict(con.execute("SELECT id, state FROM jobs"))
+        results = dict(con.execute("SELECT id, payload FROM results"))
+    finally:
+        con.close()
+    return jobs, results
+
+
+def check(name, db, expected):
+    jobs, results = rows(db)
+    ok = True
+    for job_id, payload in expected.items():
+        if results.get(job_id) != payload or jobs.get(job_id) != "done":
+            print(f"FAIL {name}: {job_id} state={jobs.get(job_id)!r} "
+                  f"result={results.get(job_id)!r} expected={payload!r}")
+            ok = False
+    if ok:
+        print(f"ok   {name}")
+    return ok
+
+
+def expect_rc(name, rc, want):
+    if rc != want:
+        print(f"FAIL {name}: child exited {rc}, expected {want}")
+        return False
+    return True
+
+
+def main():
+    expected = {"job-a": "payload-a", "job-b": "payload-b"}
+    ok = True
+    with tempfile.TemporaryDirectory() as tmp:
+        # 1. Crash right after acceptance, before any work.
+        db = os.path.join(tmp, "s1.db")
+        ok &= expect_rc("submit", child(db, "submit-then-die"), 9)
+        ok &= expect_rc("drain", child(db, "drain"), 0)
+        ok &= check("crash after submit, restart, drain", db, expected)
+
+        # 2. Crash after the running state commits, before output.
+        db = os.path.join(tmp, "s2.db")
+        ok &= expect_rc("submit", child(db, "submit-then-die"), 9)
+        ok &= expect_rc("claim", child(db, "die-after-claim"), 9)
+        ok &= expect_rc("drain", child(db, "drain"), 0)
+        ok &= check("crash after claim, restart, drain", db, expected)
+
+        # 3. Every claim interrupted several times in a row, then restart.
+        db = os.path.join(tmp, "s3.db")
+        ok &= expect_rc("submit", child(db, "submit-then-die"), 9)
+        for _ in range(3):
+            ok &= expect_rc("claim", child(db, "die-after-claim"), 9)
+        ok &= expect_rc("drain", child(db, "drain"), 0)
+        ok &= check("repeated crash after claim, restart, drain", db, expected)
+
+        # 4. Restart after completion: no rerun error, results kept.
+        ok &= expect_rc("re-drain", child(db, "drain"), 0)
+        ok &= check("restart after completion", db, expected)
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
