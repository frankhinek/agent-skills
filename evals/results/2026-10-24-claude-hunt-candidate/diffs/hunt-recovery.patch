@@ -0,0 +1,61 @@
+"""Witness: an accepted export job interrupted after its running-state commit
+must still produce its result after restart (app/export-contract.md).
+
+Exits 0 when the contract holds, 1 when the accepted job is abandoned.
+Run from the repository root: python3 tests/hunt_witness.py
+"""
+import os
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
+
+from app.export_queue import Queue  # noqa: E402
+
+
+class Interrupted(Exception):
+    pass
+
+
+def interrupt():
+    raise Interrupted()
+
+
+def main():
+    with tempfile.TemporaryDirectory() as tmp:
+        path = os.path.join(tmp, "jobs.db")
+
+        # First worker process: accept the job, then die after 'running' commits.
+        q = Queue(path)
+        ack = q.submit("job-1", "payload-1")
+        if ack != {"accepted": True, "id": "job-1"}:
+            print("setup error: unexpected submit response %r" % (ack,))
+            return 2
+        try:
+            q.work(after_claim=interrupt)
+        except Interrupted:
+            pass
+        else:
+            print("setup error: hook did not interrupt work()")
+            return 2
+        q.close()
+
+        # Restart after the previous worker stopped; the application keeps
+        # calling work() once the environment has recovered.
+        q = Queue(path)
+        for _ in range(10):
+            q.work()
+        got = q.result("job-1")
+        state = q.db.execute("SELECT state FROM jobs WHERE id = 'job-1'").fetchone()
+        q.close()
+
+    if got != "payload-1":
+        print("VIOLATION: accepted job-1 has no result after restart and "
+              "10 work() calls; result=%r, job state=%r" % (got, state and state[0]))
+        return 1
+    print("OK: accepted job-1 produced its result after restart")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
