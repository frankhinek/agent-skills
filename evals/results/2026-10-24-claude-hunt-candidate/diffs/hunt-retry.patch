@@ -0,0 +1,76 @@
+"""Witness: retrying a request ID after an interruption must not add a second item.
+
+Contract (app/export-contract.md): each accepted request adds exactly one item;
+the caller may retry the same request ID with the same payload after any
+interruption, including after a durable effect but before the response. The
+after_effect hook models termination at the real execution boundary in apply.
+
+Exits 0 if every scenario yields exactly one item, 1 otherwise.
+Run from the repository root: python3 tests/hunt_witness.py
+"""
+import os
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
+
+from app.exports import Exports  # noqa: E402
+
+
+class Terminated(Exception):
+    pass
+
+
+def terminate():
+    raise Terminated()
+
+
+def interrupted_then_retried(restart):
+    """Interrupt at after_effect, then retry the same request ID once."""
+    with tempfile.TemporaryDirectory() as tmp:
+        path = os.path.join(tmp, "jobs.db")
+        ex = Exports(path)
+        try:
+            ex.apply("req-1", "payload-A", after_effect=terminate)
+        except Terminated:
+            pass
+        if restart:
+            # The previous worker has stopped; a fresh worker opens the same file.
+            ex.close()
+            ex = Exports(path)
+        ex.apply("req-1", "payload-A")
+        items = ex.items()
+        ex.close()
+        return items
+
+
+def plain_retry():
+    """Control: uninterrupted request followed by a duplicate retry."""
+    with tempfile.TemporaryDirectory() as tmp:
+        ex = Exports(os.path.join(tmp, "jobs.db"))
+        ex.apply("req-1", "payload-A")
+        ex.apply("req-1", "payload-A")
+        items = ex.items()
+        ex.close()
+        return items
+
+
+def main():
+    scenarios = [
+        ("uninterrupted request, then retry", plain_retry),
+        ("interrupted at after_effect, retry in same worker",
+         lambda: interrupted_then_retried(restart=False)),
+        ("interrupted at after_effect, worker restart, retry",
+         lambda: interrupted_then_retried(restart=True)),
+    ]
+    failed = False
+    for name, run in scenarios:
+        items = run()
+        ok = items == ["payload-A"]
+        failed |= not ok
+        print(f"{'PASS' if ok else 'FAIL'}: {name}: items={items!r} (expected ['payload-A'])")
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
