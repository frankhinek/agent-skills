@@ -0,0 +1,138 @@
+"""Fixed export-contract cases; exit 1 if any promised result is missing."""
+from pathlib import Path
+import os
+import sqlite3
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app.export_queue import Queue
+
+
+def child(path, boundary):
+    worker = Queue(path)
+    if not worker.submit("job-1", "hello")["accepted"]:
+        raise RuntimeError("submission not accepted")
+    if boundary == "running":
+        worker.work(after_claim=lambda: os._exit(23))
+    elif boundary == "done":
+        worker.work()
+    os._exit(0)
+
+
+def check_restart(boundary):
+    with tempfile.TemporaryDirectory() as scratch:
+        path = str(Path(scratch) / "jobs.db")
+        proc = subprocess.run([sys.executable, __file__, "child", path, boundary])
+        expected_exit = 23 if boundary == "running" else 0
+        if proc.returncode != expected_exit:
+            raise RuntimeError(f"child exit {proc.returncode}, expected {expected_exit}")
+        worker = Queue(path)
+        try:
+            for _ in range(3):
+                worker.work()
+            if worker.result("job-1") != "hello":
+                raise AssertionError(f"accepted job abandoned; rows={worker.db.execute('SELECT * FROM jobs').fetchall()}")
+            if worker.work() is not False:
+                raise AssertionError("completed job repeated")
+        finally:
+            worker.close()
+
+
+def check_retries():
+    with tempfile.TemporaryDirectory() as scratch:
+        worker = Queue(str(Path(scratch) / "jobs.db"))
+        try:
+            for _ in range(2):
+                if not worker.submit("job-1", "hello")["accepted"]:
+                    raise AssertionError("retry not accepted")
+            worker.work()
+            worker.submit("job-1", "hello")
+            if worker.work() or worker.result("job-1") != "hello":
+                raise AssertionError("same-payload retry changed completion")
+        finally:
+            worker.close()
+
+
+def check_transaction_failure():
+    # Inject a one-time SQLite statement failure, not an emulated OS I/O error.
+    with tempfile.TemporaryDirectory() as scratch:
+        path = str(Path(scratch) / "jobs.db")
+        worker = Queue(path)
+        try:
+            worker.submit("job-1", "hello")
+            worker.db.execute("""CREATE TEMP TRIGGER fail_done BEFORE UPDATE OF state ON jobs
+                WHEN NEW.state = 'done' BEGIN SELECT RAISE(ABORT, 'injected failure'); END""")
+            try:
+                worker.work()
+            except sqlite3.IntegrityError as exc:
+                if str(exc) != "injected failure":
+                    raise
+            else:
+                raise RuntimeError("fault injection did not execute")
+            if worker.result("job-1") is not None:
+                raise AssertionError("result transaction failed to roll back")
+            worker.db.execute("DROP TRIGGER fail_done")
+            for _ in range(3):
+                worker.work()
+            recovered_live = worker.result("job-1") == "hello"
+        finally:
+            worker.close()
+        worker = Queue(path)
+        try:
+            for _ in range(3):
+                worker.work()
+            if not recovered_live or worker.result("job-1") != "hello":
+                raise AssertionError("result transaction failure strands accepted job on retry/restart")
+        finally:
+            worker.close()
+
+
+def check_submission_failure():
+    with tempfile.TemporaryDirectory() as scratch:
+        worker = Queue(str(Path(scratch) / "jobs.db"))
+        try:
+            worker.db.execute("""CREATE TEMP TRIGGER fail_submit BEFORE INSERT ON jobs
+                BEGIN SELECT RAISE(ABORT, 'injected submission failure'); END""")
+            try:
+                worker.submit("job-1", "hello")
+            except sqlite3.IntegrityError as exc:
+                if str(exc) != "injected submission failure":
+                    raise
+            else:
+                raise AssertionError("failed insertion reported acceptance")
+            if worker.db.execute("SELECT COUNT(*) FROM jobs").fetchone()[0]:
+                raise AssertionError("failed submission persisted")
+            worker.db.execute("DROP TRIGGER fail_submit")
+            worker.submit("job-1", "hello")
+            worker.work()
+            if worker.result("job-1") != "hello":
+                raise AssertionError("submission retry did not complete")
+        finally:
+            worker.close()
+
+
+def main():
+    cases = [(f"restart-{boundary}", lambda b=boundary: check_restart(b))
+             for boundary in ("pending", "running", "done")]
+    cases += [("same-payload-retries", check_retries),
+              ("submission-failure-retry", check_submission_failure),
+              ("result-transaction-failure", check_transaction_failure)]
+    failures = 0
+    for name, case in cases:
+        try:
+            case()
+        except AssertionError as exc:
+            failures += 1
+            print(f"FAIL {name}: {exc}")
+        else:
+            print(f"PASS {name}")
+    return int(bool(failures))
+
+
+if __name__ == "__main__":
+    if len(sys.argv) > 1 and sys.argv[1] == "child":
+        child(sys.argv[2], sys.argv[3])
+    else:
+        sys.exit(main())
