+"""Executable checks of export obligations across process interruption."""
+import os
+from pathlib import Path
+import sqlite3
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from app.export_queue import Queue
+
+
+def require(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def child(path, boundary):
+    queue = Queue(path)
+    if boundary == "accepted":
+        require(queue.submit("job", "payload")["accepted"], "submission rejected")
+        os._exit(73)
+    if boundary == "running":
+        queue.work(after_claim=lambda: os._exit(73))
+    elif boundary == "output_uncommitted":
+        # This callback runs before the done update, after the result insert
+        # has executed in the same still-uncommitted transaction.
+        def trace(sql):
+            if sql.startswith("UPDATE jobs SET state = 'done'"):
+                os._exit(73)
+        queue.db.set_trace_callback(trace)
+        queue.work()
+    elif boundary == "completed":
+        require(queue.work(), "no pending job")
+        os._exit(73)
+    raise AssertionError("crash boundary not reached")
+
+
+def main():
+    with tempfile.TemporaryDirectory(prefix="export-hunt-", dir=ROOT / "tests") as directory:
+        for boundary in ("accepted", "running", "output_uncommitted", "completed"):
+            path = str(Path(directory) / (boundary + ".sqlite"))
+            if boundary != "accepted":
+                queue = Queue(path)
+                require(queue.submit("job", "payload") ==
+                        {"accepted": True, "id": "job"}, "acceptance response")
+                queue.close()
+            process = subprocess.run([sys.executable, str(Path(__file__).resolve()),
+                                      "--child", path, boundary], check=False)
+            require(process.returncode == 73, f"{boundary}: child did not interrupt")
+            with sqlite3.connect(path) as db:
+                state = db.execute("SELECT state FROM jobs WHERE id='job'").fetchone()
+                expected = {"accepted": "pending", "running": "running",
+                            "output_uncommitted": "running", "completed": "done"}[boundary]
+                require(state == (expected,), f"{boundary}: durable job state {state}")
+                count = db.execute("SELECT count(*) FROM results").fetchone()[0]
+                require(count == (1 if boundary == "completed" else 0),
+                        f"{boundary}: unexpected durable result")
+            for restart in range(2):
+                queue = Queue(path)
+                require(queue.submit("job", "payload")["accepted"], "retry rejected")
+                worked = queue.work()
+                require(worked == (restart == 0 and boundary != "completed"),
+                        f"{boundary}: unexpected replay/completion behavior")
+                require(queue.result("job") == "payload", f"{boundary}: lost output")
+                require(not queue.work(), f"{boundary}: completed work rescheduled")
+                require(queue.db.execute("SELECT count(*) FROM results").fetchone() == (1,),
+                        f"{boundary}: duplicate output")
+                queue.close()
+            print(f"PASS {boundary}: obligation recovered; completion stable")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) > 1 and sys.argv[1] == "--child":
+        child(sys.argv[2], sys.argv[3])
+    else:
+        main()
