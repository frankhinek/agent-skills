+"""Run: python3 tests/hunt_witness.py. Nonzero means a contract violation."""
+from pathlib import Path
+import os
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from app.export_queue import Queue
+
+
+def child(path, boundary):
+    queue = Queue(path)
+    assert queue.submit('job', 'payload') == {'accepted': True, 'id': 'job'}
+    if boundary == 'pending':
+        os._exit(23)
+    if boundary == 'running':
+        queue.work(after_claim=lambda: os._exit(23))
+    elif boundary == 'done':
+        queue.work()
+        os._exit(23)
+    raise AssertionError('crash boundary was not reached')
+
+
+class RecoveryWitness(unittest.TestCase):
+    def setUp(self):
+        self.scratch = tempfile.TemporaryDirectory()
+        self.addCleanup(self.scratch.cleanup)
+        self.path = str(Path(self.scratch.name) / 'jobs.sqlite')
+
+    def crash(self, boundary):
+        completed = subprocess.run(
+            [sys.executable, str(Path(__file__).resolve()), '--child', self.path, boundary],
+            cwd=str(ROOT), check=False)
+        self.assertEqual(completed.returncode, 23, 'must reach intended crash boundary')
+
+    def reopen(self):
+        queue = Queue(self.path)
+        self.addCleanup(queue.close)
+        return queue
+
+    def drain(self, queue):
+        for _ in range(3):
+            queue.work()
+
+    def test_pending_acceptance_survives_exit(self):
+        self.crash('pending')
+        queue = self.reopen()
+        self.drain(queue)
+        self.assertEqual(queue.result('job'), 'payload')
+
+    def test_running_acceptance_survives_exit(self):
+        self.crash('running')
+        queue = self.reopen()
+        self.drain(queue)
+        state = queue.db.execute('SELECT state FROM jobs WHERE id = ?', ('job',)).fetchone()
+        self.assertEqual(queue.result('job'), 'payload',
+                         'accepted job abandoned after restart; durable state=%r' % (state,))
+
+    def test_completed_job_needs_no_work(self):
+        self.crash('done')
+        queue = self.reopen()
+        self.assertEqual(queue.result('job'), 'payload')
+        self.assertFalse(queue.work())
+        queue.submit('job', 'payload')
+        self.assertFalse(queue.work())
+        self.assertEqual(queue.db.execute('SELECT COUNT(*) FROM results').fetchone()[0], 1)
+
+    def test_output_error_then_healthy_retry(self):
+        queue = self.reopen()
+        queue.submit('job', 'payload')
+        # Inject one SQLite write error without modifying product code.
+        queue.db.execute("""CREATE TEMP TRIGGER fail_output BEFORE INSERT ON results
+                            BEGIN SELECT RAISE(ABORT, 'injected output failure'); END""")
+        with self.assertRaisesRegex(sqlite3.IntegrityError, 'injected output failure'):
+            queue.work()
+        queue.db.execute('DROP TRIGGER fail_output')
+        self.drain(queue)
+        self.assertEqual(queue.result('job'), 'payload',
+                         'accepted job abandoned after output error and healthy retry')
+
+
+if __name__ == '__main__':
+    if len(sys.argv) == 4 and sys.argv[1] == '--child':
+        child(sys.argv[2], sys.argv[3])
+    else:
+        unittest.main(verbosity=2)
