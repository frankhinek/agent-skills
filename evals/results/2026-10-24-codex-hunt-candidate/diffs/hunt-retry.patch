+"""Run from any directory: python3 tests/hunt_witness.py.
+
+Exit 1 for duplicate effects, 0 when all checked schedules satisfy the contract.
+Unexpected execution errors also exit nonzero with a traceback.
+"""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app.exports import Exports
+
+
+class Interrupted(Exception):
+    pass
+
+
+def interrupt():
+    raise Interrupted("interrupted after durable effect")
+
+
+def check(mode, directory):
+    path = str(Path(directory) / (mode + ".sqlite"))
+    if mode == "termination":
+        child = subprocess.run([sys.executable, str(Path(__file__).resolve()),
+                                "--terminate", path], check=False)
+        if child.returncode != 73:
+            raise RuntimeError(f"unexpected child exit: {child.returncode}")
+    else:
+        app = Exports(path)
+        try:
+            if mode == "normal":
+                assert app.apply("request-1", "payload") is True
+            else:
+                try:
+                    app.apply("request-1", "payload", after_effect=interrupt)
+                except Interrupted:
+                    pass
+                else:
+                    raise RuntimeError("interruption hook did not run")
+            if mode == "exception_same_connection":
+                assert app.apply("request-1", "payload") is True
+        finally:
+            app.close()
+    app = Exports(path)
+    try:
+        before = app.items()
+        assert app.apply("request-1", "payload") is True
+        assert app.apply("request-1", "payload") is True
+        after = app.items()
+        passed = after == ["payload"]
+        print(f"{'PASS' if passed else 'FAIL'} {mode}: "
+              f"before final retries={before!r}; after={after!r}; "
+              "expected=['payload']")
+        return passed
+    finally:
+        app.close()
+
+
+def main():
+    if len(sys.argv) == 3 and sys.argv[1] == "--terminate":
+        app = Exports(sys.argv[2])
+        app.apply("request-1", "payload", after_effect=lambda: os._exit(73))
+        raise RuntimeError("termination hook did not run")
+    with tempfile.TemporaryDirectory(prefix="export-hunt-") as directory:
+        results = [check(mode, directory) for mode in
+                   ("normal", "exception_same_connection", "exception_restart",
+                    "termination")]
+    return 0 if all(results) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
